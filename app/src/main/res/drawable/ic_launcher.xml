<?xml version="1.0" encoding="utf-8"?>
<!--
    Yeh file jaan-boojh kar delete nahi ki gayi — phone ka sync tool
    deletions ko GitHub tak push nahi kar pa raha tha, is liye ic_launcher.xml
    aur ic_launcher.png dono GitHub par ikathay reh jate thay ("Duplicate
    resources" error). Ab dono ka naam alag hai (is xml ka naam "ic_launcher",
    asal image ka naam "ic_launcher_img"), is liye koi conflict nahi hoga,
    delete ki zaroorat hi khatam ho gayi.
-->
<bitmap xmlns:android="http://schemas.android.com/apk/res/android"
    android:src="@drawable/ic_launcher_img"
    android:gravity="fill" />
